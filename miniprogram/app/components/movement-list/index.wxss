.movement{box-sizing:border-box;min-width:0;background:#fff;border:1rpx solid #e5ebe6;border-radius:24rpx;padding:26rpx;margin-bottom:18rpx}.line{display:flex;align-items:center;justify-content:space-between;gap:12rpx;flex-wrap:wrap}.label{font-size:22rpx;color:#245b48;background:#e9f3e9;border-radius:9rpx;padding:3rpx 14rpx}.out{color:#a2733f;background:#f8eee0}.amount{overflow-wrap:anywhere;font-size:31rpx;font-weight:700;color:#245b48}.out-text{color:#a2733f}.product{overflow-wrap:anywhere;font-size:29rpx;font-weight:600;margin:18rpx 0 10rpx}.code,.balance{overflow-wrap:anywhere;font-size:24rpx;color:#677b6d}.code{font-family:Menlo,monospace}.meta,.document{overflow-wrap:anywhere;font-size:22rpx;color:#8b978e;margin-top:12rpx}.document{word-break:break-all;font-family:Menlo,monospace}.note{overflow-wrap:anywhere;font-size:24rpx;color:#65776a;border-top:1rpx solid #edf1ec;padding-top:14rpx;margin-top:14rpx;white-space:pre-wrap}
