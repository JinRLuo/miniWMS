<view class="login">
  <view class="brand"><view class="brand-icon"><image src="/assets/icons/warehouse-white.png" mode="aspectFit" /></view><text>Mini WMS</text></view>
  <view class="intro"><view class="eyebrow">WAREHOUSE, SIMPLIFIED</view><view class="title">鱼胶库存<view>随手掌握。</view></view><view class="subtitle">扫码定位格子，轻松完成每一笔出入库。</view></view>
  <view class="card">
    <view class="section-title mb">微信登录仓库</view>
    <view class="notice" wx:if="{{notice}}">{{notice}}</view>
    <view class="login-description">授权微信手机号以识别仓库账号。首次登录后，需由管理员授予权限才能使用。</view>
    <view class="error" wx:if="{{error}}">{{error}}</view>
    <button class="primary" open-type="getPhoneNumber" bindgetphonenumber="login" loading="{{busy}}" disabled="{{busy}}">授权手机号并微信登录</button>
  </view>
  <view class="footer">微信身份认证 · 管理员授权后使用</view>
</view>
