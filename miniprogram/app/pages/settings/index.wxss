.profile { display: flex; gap: 22rpx; align-items: center; margin: 36rpx 0; }
.profile > view:last-child { min-width: 0; overflow-wrap: anywhere; }
.avatar { background: #e0ebde; color: #245b48; width: 100rpx; height: 100rpx; flex: 0 0 100rpx; border-radius: 32rpx; text-align: center; font-size: 44rpx; font-weight: 700; line-height: 100rpx; }
.page button.choice:not([size='mini']) { width: 100%; min-width: 0; background: #f7faf5; color: #78897c; border: 2rpx solid #e3ebe1; padding: 24rpx 12rpx; }
.page button.choice.selected { border-color: #4d7d58; background: #edf5e9; color: #245b48; }
.choice view { font-size: 42rpx; line-height: 1.3; }
.choice text { display: block; font-size: 22rpx; font-weight: 400; white-space: nowrap; margin-top: 8rpx; }
.unit-note { margin: 26rpx 0; overflow-wrap: anywhere; }
.version { text-align: center; font-size: 21rpx; color: #9aa69b; margin-top: 36rpx; }
