.bar {
  position: fixed; bottom: 0; left: 0; right: 0; display: flex; box-sizing: border-box;
  background: #fff; border-top: 1rpx solid #e4ebe5; box-shadow: 0 -6rpx 24rpx rgba(32, 60, 50, .025);
  padding: 14rpx 24rpx calc(12rpx + env(safe-area-inset-bottom)); z-index: 20;
}
.tab { flex: 1 1 0%; min-width: 0; display: flex; flex-direction: column; align-items: center; color: #8b968e; padding: 0; }
.icon-wrap { display: flex; align-items: center; justify-content: center; width: 88rpx; height: 54rpx; border-radius: 20rpx; }
.icon { display: block; width: 44rpx; height: 44rpx; }
.label { font-size: 22rpx; line-height: 32rpx; font-weight: 500; margin-top: 4rpx; white-space: nowrap; }
.active { color: #245b48; }
.active .icon-wrap { background: #eaf2eb; }
.active .label { font-weight: 600; }
.tab-pressed { opacity: .65; }
